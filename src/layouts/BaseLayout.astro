---
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/sora/800.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/700.css';
import '@styles/global.css';
import Header from '@components/Header.astro';
import SeoTags from '@components/SeoTags.astro';
import Footer from '@components/Footer.astro';
import MobileCallBar from '@components/MobileCallBar.astro';
import { site } from '@data/site';

interface Props {
  title: string;
  description: string;
  /** kök-göreli yol, örn. "/hizmetler". Verilmezse geçerli sayfa yolu. */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  /** ekstra JSON-LD nesneleri (Service, FAQPage, Breadcrumb vb.) */
  schemas?: object[];
  /** Sayfa altındaki arama ifadeleri bloğu için bölge adı. Boş bırakılırsa Ankara. */
  seoArea?: string;
}

const { title, description, path, ogImage = '/og-image.png', noindex = false, schemas = [],
  seoArea = 'Ankara',
} = Astro.props;

const canonicalPath = path ?? new URL(Astro.request.url).pathname;
const canonical = new URL(canonicalPath === '/' ? '/' : canonicalPath.replace(/\/$/, ''), site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const districtNames = ['Sincan', 'Yenikent', 'Etimesgut', 'Çankaya', 'Yenimahalle', 'Mamak', 'Keçiören', 'Kahramankazan', 'Pursaklar', 'Gölbaşı'];

// Google'da alan adı yerine marka adının çıkması için WebSite şeması.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: 'Mr Volt Elektrik',
  url: site.url,
};

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  slogan: site.slogan,
  url: site.url,
  telephone: site.phone.e164,
  image: ogUrl,
  logo: new URL('/icons/icon-512.png', site.url).href,
  priceRange: '₺₺',
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.countryCode,
  },
  areaServed: districtNames.map((n) => ({ '@type': 'City', name: `${n}, Ankara` })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: site.hours.opens,
      closes: site.hours.closes,
    },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phone.e164,
    contactType: 'customer service',
    areaServed: 'TR',
    availableLanguage: ['tr'],
  },
};

const allSchemas = [websiteSchema, businessSchema, ...schemas];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b1026" />
    <meta name="author" content={site.name} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <SeoTags area={seoArea} />
    <Footer />
    <MobileCallBar />

    <style>
      .skip-link {
        position: absolute;
        left: 0.5rem;
        top: -3rem;
        z-index: 300;
        background: var(--volt);
        color: #fff;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        font-weight: 700;
        transition: top var(--dur) var(--ease);
      }
      .skip-link:focus {
        top: 0.5rem;
      }
      /* mobil arama çubuğu için altta boşluk */
      @media (max-width: 720px) {
        body {
          padding-bottom: 4.5rem;
        }
      }
    </style>

    <script>
      // Tek, ölçülü giriş animasyonu: görünür olunca .reveal öğeleri belirir.
      const els = document.querySelectorAll('.reveal');
      if (els.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
