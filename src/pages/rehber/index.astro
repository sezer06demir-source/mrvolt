---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Icon from '@components/Icon.astro';
import CTASection from '@components/CTASection.astro';
import { posts } from '@data/blog';

const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));

const title = 'Elektrik Rehberi — Mr Volt Ankara Elektrikçi';
const description =
  "Sigorta atması, kaçak akım rölesi, priz arızaları ve daha fazlası. Ankara elektrikçi Mr Volt'tan sahadan, sade ve doğru elektrik rehberi yazıları.";
const fmtDate = (d: string) => {
  const [y, m, day] = d.split('-');
  const aylar = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
  return `${Number(day)} ${aylar[Number(m) - 1]} ${y}`;
};
---

<BaseLayout title={title} description={description} path="/rehber">
  <PageHero
    eyebrow="Rehber"
    title="Elektrik rehberi"
    subtitle="Sık yaşanan elektrik sorunlarını sahadan, sade bir dille anlatıyoruz. Amacımız satmak değil; ne olduğunu anlamanıza ve doğru adımı atmanıza yardımcı olmak."
    crumbs={[{ label: 'Rehber' }]}
  />

  <section class="section">
    <div class="container">
      <div class="rehber-grid">
        {
          sorted.map((p) => (
            <article class="post reveal">
              <a href={`/rehber/${p.slug}`} class="post__link">
                <img class="post__cover" src={p.image ?? `/rehber/kapak/${p.slug}.png`} alt={p.imageAlt ?? p.title} width="1200" height="630" loading="lazy" decoding="async" />
                <div class="post__body">
                  <div class="post__meta">
                    <span class="post__tag">{p.keyword}</span>
                    <span class="post__date">{fmtDate(p.date)} · {p.readingMin} dk</span>
                  </div>
                  <h2 class="post__title">{p.title}</h2>
                  <p class="post__excerpt">{p.excerpt}</p>
                  <span class="post__go">Yazıyı oku <Icon name="arrow-right" size={16} /></span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .rehber-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 1fr;
  }
  .post {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .post:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: transparent;
  }
  .post__link {
    display: block;
  }
  .post__cover {
    width: 100%;
    height: auto;
    display: block;
    border-bottom: 1px solid var(--line);
  }
  .post__body {
    padding: 1.6rem;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }
  .post__tag {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--volt);
    background: color-mix(in srgb, var(--volt) 10%, white);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .post__date {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .post__title {
    font-size: var(--fs-lg);
  }
  .post__excerpt {
    margin-top: 0.6rem;
    color: var(--muted);
  }
  .post__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--volt);
  }
  @media (min-width: 720px) {
    .rehber-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
