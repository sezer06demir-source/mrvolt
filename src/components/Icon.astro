// Doldurulmuş ikonlar (yıldız, whatsapp) ayrı işlenir.
const isStar = name === 'star';
const isWhatsapp = name === 'whatsapp';
const d = paths[name] ?? paths.zap;
---

{
  isStar ? (
    <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={cls} aria-hidden="true">
