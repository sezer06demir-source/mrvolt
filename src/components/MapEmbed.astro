---
/** Ankara'yı gösteren genel harita (açık adres yok, şehir seviyesi). */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const src = 'https://www.google.com/maps?q=Ankara,+T%C3%BCrkiye&z=10&output=embed';
---

<div class={`mapembed ${cls}`}>
  <iframe
    src={src}
    title="Mr Volt hizmet bölgesi — Ankara"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen></iframe>
</div>

<style>
  .mapembed {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-2);
    line-height: 0;
  }
  .mapembed iframe {
    width: 100%;
    height: 100%;
    min-height: 320px;
    border: 0;
    filter: saturate(1.05);
  }
</style>
