---
import Icon from '@components/Icon.astro';
import { site } from '@data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Elektrik arızası beklemez. Hemen arayın.',
  text = 'Telefonda durumu birlikte değerlendirelim; gerekiyorsa aynı gün kapınızda olalım.',
} = Astro.props;
---

<section class="ctaband dark">
  <div class="container ctaband__in">
    <div class="ctaband__glow" aria-hidden="true"></div>
    <div class="ctaband__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="ctaband__actions">
      <a href={site.phone.href} class="btn btn--spark btn--lg"><Icon name="phone" size={20} /> {site.phone.display}</a>
      <a href={site.whatsapp.href} class="btn btn--ghost btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .ctaband {
    background: linear-gradient(120deg, #14183a, #0b1026);
  }
  .ctaband__in {
    position: relative;
    display: grid;
    gap: 1.75rem;
    align-items: center;
    padding-block: clamp(2.6rem, 1.6rem + 4vw, 4rem);
    overflow: hidden;
  }
  .ctaband__glow {
    position: absolute;
    right: -5%;
    top: -60%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(75, 59, 255, 0.5), transparent 65%);
    z-index: 0;
  }
  .ctaband__copy,
  .ctaband__actions {
    position: relative;
    z-index: 1;
  }
  .ctaband__copy h2 {
    font-size: var(--fs-xl);
    color: #fff;
  }
  .ctaband__copy p {
    margin-top: 0.6rem;
    color: var(--on-dark-muted);
    max-width: 52ch;
  }
  .ctaband__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 880px) {
    .ctaband__in {
      grid-template-columns: 1fr auto;
    }
  }
</style>
