---
import Icon from '@components/Icon.astro';
import { site } from '@data/site';
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const all: Crumb[] = [{ label: 'Ana sayfa', href: '/' }, ...items];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---

<nav class="crumb" aria-label="İçerik yolu">
  <ol>
    {
      all.map((c, i) => (
        <li>
          {c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          {i < all.length - 1 && <Icon name="chevron-right" size={14} class="crumb__sep" />}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .crumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
  }
  .crumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .crumb a {
    color: var(--on-dark-muted);
    transition: color var(--dur) var(--ease);
  }
  .crumb a:hover {
    color: var(--spark);
  }
  .crumb span[aria-current] {
    color: #fff;
    font-weight: 600;
  }
  .crumb :global(.crumb__sep) {
    color: var(--on-dark-muted);
    opacity: 0.6;
  }
</style>
