---
import Icon from '@components/Icon.astro';
import { site } from '@data/site';
---

<div class="callbar" aria-label="Hızlı iletişim">
  <a href={site.phone.href} class="callbar__btn callbar__btn--call">
    <Icon name="phone" size={20} />
    <span>Hemen ara</span>
  </a>
  <a href={site.whatsapp.href} class="callbar__btn callbar__btn--wa" target="_blank" rel="noopener">
    <Icon name="whatsapp" size={20} />
    <span>WhatsApp</span>
  </a>
</div>

<style>
  .callbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: none;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem calc(0.55rem + env(safe-area-inset-bottom));
    background: rgba(11, 16, 38, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .callbar__btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem;
    border-radius: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-base);
  }
  .callbar__btn--call {
    background: var(--spark);
    color: #241a00;
  }
  .callbar__btn--wa {
    background: #25d366;
    color: #06371b;
  }
  @media (max-width: 720px) {
    .callbar {
      display: flex;
    }
  }
</style>
